:{$PORT:80} {
	root * {$PUBLIC_ROOT:dist}
	try_files {path} {path}/index.html /index.html
	file_server

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@shortCache path /robots.txt /sitemap.xml
	header @shortCache Cache-Control "public, max-age=3600"

	@manifest path /site.webmanifest
	header @manifest Content-Type "application/manifest+json"
	header @manifest Cache-Control "public, max-age=3600"

	@appAssociation path /.well-known/* /apple-app-site-association
	header @appAssociation Content-Type "application/json"
	header @appAssociation Cache-Control "public, max-age=3600"

	@html path / /index.html
	header @html Cache-Control "no-cache"
}
